{
  "name": "lettras",
  "version": "0.1.0",
  "description": "Word-search generator for 6 languages with native accented letters (es, en, pt, fr, de, it). Runs locally via WebAssembly. Library and CLI.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" }
  },
  "bin": { "lettras": "./bin/lettras.js" },
  "files": ["bin", "src", "engine", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": ["word-search", "puzzle", "wordsearch", "wasm", "unicode", "i18n", "spanish", "mcp"],
  "engines": { "node": ">=20" },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Artificialss/lettras-sdk#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Artificialss/lettras-sdk.git", "directory": "npm" },
  "bugs": { "url": "https://github.com/Artificialss/lettras-sdk/issues" },
  "author": "Artificialss (https://artificialss.ai)"
}
