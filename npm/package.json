{
  "name": "lettras",
  "version": "0.5.0",
  "description": "Word-search, crossword (crucigrama) and sudoku generators plus Unicode text styles for 6 languages (es, en, pt, fr, de, it), with native accented letters kept. Runs locally via WebAssembly, no network or API key. Library and CLI.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "lettras": "bin/lettras.js"
  },
  "files": [
    "bin",
    "src",
    "engine",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "word-search",
    "puzzle",
    "wordsearch",
    "wasm",
    "unicode",
    "unicode-text",
    "text-styles",
    "fancy-text",
    "font-generator",
    "i18n",
    "accents",
    "spanish",
    "portuguese",
    "french",
    "german",
    "italian",
    "mcp",
    "crossword",
    "crucigrama",
    "sudoku"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Artificialss/lettras-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artificialss/lettras-sdk.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/Artificialss/lettras-sdk/issues"
  },
  "author": "Artificialss (https://artificialss.ai)"
}
