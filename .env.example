# All optional. The MCP server runs the compiled engine in-process and needs no credentials to start.
# Set real values in Vercel's project settings (mark secrets as sensitive), never in git.

# Free tier: puzzles per client per window, then the response points to the Lettras page.
LETTRAS_FREE_LIMIT=5
# Window in seconds (86400 = per day). 0 = never resets.
LETTRAS_LIMIT_WINDOW_SECS=86400
LETTRAS_UPGRADE_URL=https://lettras.org

# Shared counter: a Postgres connection string (Neon: use the POOLED one, host contains "-pooler").
# The server creates its own `mcp_usage` table. Without it the counter lives in each function
# instance's memory and is not reliable on serverless.
DATABASE_URL=
